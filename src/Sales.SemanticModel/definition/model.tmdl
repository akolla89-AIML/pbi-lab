model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["SqlEndpoint","LakehouseName","DimCustomer","DimDate","DimGeography","DimProduct","FactSales","FactSalesTarget","UserRegion"]

annotation PBI_ProTooling = ["DevMode","DaxQueryView_Desktop","TMDLView_Desktop"]

ref table DimCustomer
ref table DimDate
ref table DimGeography
ref table DimProduct
ref table FactSales
ref table FactSalesTarget
ref table UserRegion

ref role RegionalAccess

ref cultureInfo en-US

